# ── Site ──────────────────────────────────────────────────
SITE_ID=demo-site-01
SITE_NAME=Ella Demo Anlage

# ── Database ───────────────────────────────────────────────
ELLA_DB_PATH=/data/ella-edge.db

# ── Config ─────────────────────────────────────────────────
ELLA_CONFIG_DIR=/config

# ── Simulation ─────────────────────────────────────────────
SIMULATION_MODE=true
SIMULATION_SCENARIO=summer_high_pv

# ── Backend API ────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-me-in-production

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
