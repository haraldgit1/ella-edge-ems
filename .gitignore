# Environment
.env
.env.local

# Data & Logs (runtime only)
data/*.db
data/*.db-shm
data/*.db-wal
logs/**/*.log
logs/**/
reports/*.pdf
reports/*.csv
reports/*.zip
reports/*.json
reports/tmp/

# Keep placeholder dirs
!data/.gitkeep
