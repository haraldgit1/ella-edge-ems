!reports/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend
backend-api/node_modules/
backend-api/dist/

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/venv/
**/.pytest_cache/

# NGINX certs (runtime)
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt

